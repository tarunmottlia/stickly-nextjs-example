# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# needed for `next start` outside Vercel (Vercel sets it for you)
AUTH_TRUST_HOST=true

# Stickly — app.stickly.live → Settings → API keys → "Download .env"
NEXT_PUBLIC_STICKLY_PUBLIC_KEY=pk_live_YOUR_KEY
# server only: signs the token that tells Stickly which user is claiming
STICKLY_SIGNING_SECRET=
# server only: exists only AFTER you save a webhook URL in Integrate → Connect
STICKLY_WEBHOOK_SECRET=
# server only: used to derive an opaque user id (never send emails to a third party)
USER_ID_SALT=change-me
